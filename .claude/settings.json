      "mcp__cornercad-com__wp_write_blocks",
      "mcp__cornercad-com__wp_insert_block_pattern",
      "mcp__cornercad-com__mwai_image",

      "mcp__cornercad-com__wc_create_product",
      "mcp__cornercad-com__wc_update_product",
      "mcp__cornercad-com__wc_alter_product",
      "mcp__cornercad-com__wc_delete_product",
      "mcp__cornercad-com__wc_update_stock",
      "mcp__cornercad-com__wc_bulk_update_stock",
      "mcp__cornercad-com__wc_update_order_status",
      "mcp__cornercad-com__wc_add_order_note",
      "mcp__cornercad-com__wc_create_refund",
