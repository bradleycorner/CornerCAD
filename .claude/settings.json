      "mcp__woocommerce__woocommerce-orders-list",
      "mcp__woocommerce__woocommerce-orders-get"
    ],
    "ask": [
      "mcp__woocommerce__woocommerce-products-create",
      "mcp__woocommerce__woocommerce-products-update",
      "mcp__woocommerce__woocommerce-products-delete",
      "mcp__woocommerce__woocommerce-orders-create",
