{
  "permissions": {
    "allow": [
      "mcp__woocommerce__woocommerce-products-list",
      "mcp__woocommerce__woocommerce-products-get",
      "mcp__woocommerce__woocommerce-orders-list",
      "mcp__woocommerce__woocommerce-orders-get"
    ],
    "ask": [
      "mcp__woocommerce__woocommerce-products-create",
      "mcp__woocommerce__woocommerce-products-update",
      "mcp__woocommerce__woocommerce-products-delete",
      "mcp__woocommerce__woocommerce-orders-create",
      "mcp__woocommerce__woocommerce-orders-update",

      "mcp__cornercad-com__wp_create_post",
      "mcp__cornercad-com__wp_update_post",
      "mcp__cornercad-com__wp_alter_post",
      "mcp__cornercad-com__wp_delete_post",
      "mcp__cornercad-com__wp_update_post_meta",
      "mcp__cornercad-com__wp_delete_post_meta",
      "mcp__cornercad-com__wp_add_post_terms",
      "mcp__cornercad-com__wp_set_featured_image",
      "mcp__cornercad-com__wp_create_term",
      "mcp__cornercad-com__wp_update_term",
      "mcp__cornercad-com__wp_delete_term",
      "mcp__cornercad-com__wp_upload_media",
      "mcp__cornercad-com__wp_upload_request",
      "mcp__cornercad-com__wp_update_media",
      "mcp__cornercad-com__wp_delete_media",
      "mcp__cornercad-com__wp_update_option",
      "mcp__cornercad-com__wp_create_user",
      "mcp__cornercad-com__wp_update_user",
      "mcp__cornercad-com__wp_create_comment",
      "mcp__cornercad-com__wp_update_comment",
      "mcp__cornercad-com__wp_delete_comment",
      "mcp__cornercad-com__wp_write_blocks",
      "mcp__cornercad-com__wp_insert_block_pattern",
      "mcp__cornercad-com__mwai_image"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ToolSearch",
        "hooks": [
          {
            "type": "command",
            "command": "IN=$(cat); SID=$(printf '%s' \"$IN\" | jq -r '.session_id // \"nosession\"'); if printf '%s' \"$IN\" | grep -qi 'concretecms'; then touch \"${TMPDIR:-/tmp}/cc-schema-$SID.flag\"; fi",
            "timeout": 10,
            "statusMessage": "Recording concretecms schema discovery…"
          }
        ]
      }
    ]
  }
}
