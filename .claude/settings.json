      "mcp__cornercad-com__wp_set_featured_image",
      "mcp__cornercad-com__wp_create_term",
      "mcp__cornercad-com__wp_update_term",
      "mcp__cornercad-com__wp_delete_term",
      "mcp__cornercad-com__wp_upload_media",
      "mcp__cornercad-com__wp_upload_request",
      "mcp__cornercad-com__wp_update_media",
      "mcp__cornercad-com__wp_delete_media",
      "mcp__cornercad-com__wp_update_option",
      "mcp__cornercad-com__wp_create_user",
