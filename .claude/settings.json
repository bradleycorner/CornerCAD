      "mcp__cornercad-com__wp_copy_plugin",
      "mcp__cornercad-com__wp_rename_plugin",
      "mcp__cornercad-com__wp_delete_plugin",
      "mcp__cornercad-com__wp_plugin_put_file",
      "mcp__cornercad-com__wp_plugin_alter_file",
      "mcp__cornercad-com__wp_plugin_mkdir",
      "mcp__cornercad-com__wp_plugin_delete_path",

      "mcp__cornercad-com__wp_switch_theme",
      "mcp__cornercad-com__wp_create_theme",
      "mcp__cornercad-com__wp_copy_theme",
      "mcp__cornercad-com__wp_rename_theme",
      "mcp__cornercad-com__wp_delete_theme",
      "mcp__cornercad-com__wp_theme_put_file",
      "mcp__cornercad-com__wp_theme_alter_file",
      "mcp__cornercad-com__wp_theme_mkdir",
      "mcp__cornercad-com__wp_theme_delete_path",
      "mcp__cornercad-com__wp_theme_set_screenshot"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ToolSearch",
        "hooks": [
          {
            "type": "command",
            "command": "IN=$(cat); SID=$(printf '%s' \"$IN\" | jq -r '.session_id // \"nosession\"'); if printf '%s' \"$IN\" | grep -qi 'concretecms'; then touch \"${TMPDIR:-/tmp}/cc-schema-$SID.flag\"; fi",
            "timeout": 10,
            "statusMessage": "Recording concretecms schema discovery…"
          }
        ]
      }
    ]
  }
}
